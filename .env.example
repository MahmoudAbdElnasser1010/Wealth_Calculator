SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///wealth.db
# Optional: https://www.goldapi.io API key. When set, karat prices come straight from GoldAPI;
# otherwise the free gold-api.com spot price is used and karat prices are derived from purity.
GOLDAPI_KEY=
# Seconds to cache gold prices and exchange rates
PRICE_CACHE_TTL=600
